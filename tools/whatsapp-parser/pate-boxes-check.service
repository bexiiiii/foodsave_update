[Unit]
Description=Pate Box Parser HTTP UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pate-boxes-check
ExecStart=/usr/bin/python3 /opt/pate-boxes-check/server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
